{
  "name": "myperro",
  "private": true,
  "version": "0.9.0-rc.8",
  "description": "A privacy-first virtual desktop companion for Windows, macOS, and Linux",
  "author": "Sabin Raut",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "demo": "vite --open /demo.html",
    "site:assets": "node scripts/build-website-assets.mjs",
    "site:dev": "npm run site:assets && vite --config website/vite.config.ts",
    "site:build": "npm run site:assets && vite build --config website/vite.config.ts",
    "art:shiba": "node scripts/generate-dog-atlases.mjs",
    "art:dogs": "node scripts/generate-dog-atlases.mjs",
    "art:companions": "node scripts/generate-dog-atlases.mjs",
    "art:premium": "python scripts/build-all-premium-atlases.py",
    "setup": "bash scripts/setup.sh",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "start": "tauri dev",
    "release": "tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate-pack": "tsx scripts/validate-pack.mjs",
    "validate:packs": "node scripts/validate-all-packs.mjs",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "sbom": "cyclonedx-npm --output-file myperro-web.cdx.json --spec-version 1.6",
    "checksums": "node scripts/checksums.mjs",
    "release:assets": "node scripts/prepare-release-assets.mjs",
    "release:check": "npm run typecheck && npm test && npm run build && npm run site:build && npm run validate:packs && npm run smoke:dist && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.6.0",
    "vite": "^8.2.1",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.1"
  }
}
